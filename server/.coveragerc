[run]
branch = True
source =
    accounts
    repairs
    workshop
    config
omit =
    */migrations/*
    */tests/*
    manage.py
    config/asgi.py
    config/wsgi.py

[report]
show_missing = True
precision = 2
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
