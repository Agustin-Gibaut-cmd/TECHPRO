# ==========================================
# TECHPRO - CONFIGURACIÓN DEL BACKEND
# ==========================================

# Claves criptográficas principales (mínimo 50 caracteres cada una)
DJANGO_SECRET_KEY=replace-with-a-random-secret-at-least-50-characters-long
JWT_SIGNING_KEY=replace-with-another-distinct-random-secret-at-least-50-characters

# Entorno y Hosts permitidos
DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes autorizados para CORS y CSRF
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Base de datos (postgresql | sqlite)
DB_ENGINE=postgresql
DB_NAME=nombre_base_de_datos
DB_USER=usuario_postgres
DB_PASSWORD=tu_contraseña_segura
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer
DB_CONN_MAX_AGE=60

# Configuración de Tokens JWT y Sesiones (opcional, valores por defecto indicados)
# JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
# JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# AUTH_PASSWORD_MIN_LENGTH=12

# Rate Limiting (opcional)
# THROTTLE_RATE_ANON=30/minute
# THROTTLE_RATE_USER=120/minute
# THROTTLE_RATE_LOGIN=5/minute

# Parámetros de Reportes (opcional)
# REPORT_MONTHS_WINDOW=6
# REPORT_TOP_PRODUCTS_LIMIT=5

# Seguridad HTTPS y Headers
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
