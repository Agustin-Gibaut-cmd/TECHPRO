# TECHPRO - CONFIGURACIÓN DEL BACKEND

# DJANGO Y AUTENTICACIÓN JWT
DJANGO_SECRET_KEY=
JWT_SIGNING_KEY=

# ENTORNO
DEBUG=
ENVIRONMENT=
DJANGO_ALLOWED_HOSTS=

# CORS Y CSRF
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# BASE DE DATOS POSTGRESQL (127.0.0.1 para consola local; Docker Compose lo sobrescribe a 'db')
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_SSLMODE=
DB_CONN_MAX_AGE=

# SQLITE (solo para desarrollo y pruebas con DEBUG=true)
# SQLITE_DB_NAME=test_local.sqlite3

# CONFIGURACIÓN DE TOKENS JWT Y SESIONES (opcional)
# JWT_ACCESS_TOKEN_LIFETIME_MINUTES=
# JWT_REFRESH_TOKEN_LIFETIME_DAYS=
# AUTH_PASSWORD_MIN_LENGTH=

# RATE LIMITING (opcional)
# THROTTLE_RATE_ANON=
# THROTTLE_RATE_USER=
# THROTTLE_RATE_LOGIN=

# PARÁMETROS DE REPORTES (opcional)
# REPORT_MONTHS_WINDOW=
# REPORT_TOP_PRODUCTS_LIMIT=

# SEGURIDAD HTTPS (Desactivada en desarrollo local)
SECURE_SSL_REDIRECT=
SECURE_HSTS_SECONDS=